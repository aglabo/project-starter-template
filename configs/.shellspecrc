# ============================================================================
# ShellSpec Configuration
# ============================================================================
# This file contains all ShellSpec options for the project.
# Loaded from .shellspec via: --options configs/.shellspecrc
#
# See: https://github.com/shellspec/shellspec
# ============================================================================


# === Base Configuration ===
# Core testing setup: helpers, sandbox, and example handling

# shell
--shell bash

# File Patter
--pattern *.spec.sh

# Spec file directory (default search path)
# --default-path scripts/__tests__

# Load helper modules
--require spec_helper
--require ksh_workaround

# Helper directory location
--helperdir .tools/shellspec/helper

# Enable sandbox mode for isolated testing
--sandbox

# Skip message verbosity level
--skip-message moderate

# Fail if no test examples are found
--fail-no-examples


# === Shell Execution Options ===
# Environment and shell behavior configuration

# Load environment setup script
# --env-from .tools/shellspec/helper/env.sh

# Hide deprecation warnings for cleaner output
--hide-deprecations


# === Coverage Configuration ===
# Code coverage options for kcov integration

# Coverage include/exclude patterns
# Note: Adjust these paths according to your project structure
# --kcov-options "--include-pattern="
# --kcov-options "--include-path=./shellspec,./install.sh,./lib,./libexec"
# --kcov-options "--exclude-pattern=/.,_generated.sh"


# === Reporting Options ===
# Output formatting and reporting configuration
# (Add custom reporting options here as needed)

# Example options (enabled for better readability):
--format documentation
--color
# --profile 10
