{
  "name": "@aglabo/project-starter-template",
  "version": "1.0.0",
  "private": true,
  "description": "Development environment for project-starter-template",
  "keywords": [
    "template",
    "starter",
    "oss",
    "development"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/atsushifx/project-starter-template.git"
  },
  "license": "MIT",
  "author": "atsushifx",
  "type": "module",
  "scripts": {
    "prepare": "bash ./scripts/setup-dev-env.sh",
    "scan:secrets": "concurrently --raw --group \"bash runners/run-betterleaks.sh\" \"bash runners/run-secretlint.sh\"",
    "check:dprint": "dprint check --list-different",
    "check:dprint:diff": "dprint check",
    "format:dprint": "dprint fmt",
    "check:sh": "bash runners/run-shfmt.sh --list .",
    "format:sh": "bash runners/run-shfmt.sh --format .",
    "lint:sh": "bash runners/run-shellcheck.sh ",
    "test:sh": "bash runners/run-shellspec.sh ",
    "test:sh:all": "bash runners/run-shellspec.sh all",
    "lint:gha": "concurrently --raw --group \"pnpm run lint:gha:actions\" \"pnpm run lint:gha:workflows\"",
    "lint:gha:actions": "bash runners/run-actionlint.sh ",
    "lint:gha:workflows": "concurrently --raw --group \"bash runners/run-ghalint.sh run\" \"bash runners/run-ghalint.sh act\"",
    "lint:spells": "cspell --config .vscode/cspell.json --cache --cache-location .cache/cspell/cSpellCache ",
    "lint:text": "bash runners/run-textlint.sh ",
    "lint:markdown": "bash runners/run-markdownlint.sh "
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "pnpm": ">=12"
  },
  "@(#)": "project-starter-template: template for new project development"
}
